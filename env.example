# ══════════════════════════════════════════════════════════════════
#  AstroSentinel — System Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════


# ─── Server ───────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development

# API route prefix  (all routes become /api/v1/...)
API_PREFIX=/api/v1


# ─── CORS ─────────────────────────────────────────────────────────
# Allowed origin(s) for cross-origin requests.
# Use * for development; set your frontend domain in production.
#   Examples:
#     CORS_ORIGIN=*
#     CORS_ORIGIN=https://astrosentinel.yourdomain.com
CORS_ORIGIN=*


# ─── Rate Limiting ────────────────────────────────────────────────
# Window duration in milliseconds (default: 60 000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per IP per window (default: 120)
RATE_LIMIT_MAX_REQ=120


# ─── AI Engine ────────────────────────────────────────────────────
# Number of synthetic samples used during server startup warm-up.
# Minimum 60 required for the engine to begin scoring.
AI_WARMUP_SAMPLES=300


# ─── NOAA SWPC Data Source ────────────────────────────────────────
# Base URL for NOAA Space Weather Prediction Center REST API.
# Change only if you are mirroring / proxying NOAA data internally.
NOAA_BASE_URL=https://services.swpc.noaa.gov/products/

# CORS proxy used when calling NOAA from a browser environment.
# In a pure server-side deployment this is not needed — remove the
# proxy prefix and call NOAA directly.
NOAA_CORS_PROXY=https://corsproxy.io/?url=

# Timeout (ms) for NOAA fetch requests (default: 8 000)
NOAA_FETCH_TIMEOUT_MS=8000


# ─── Logging ──────────────────────────────────────────────────────
# Log level: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# Set to "true" to pretty-print JSON logs in development
LOG_PRETTY=true


# ─── Security (Production) ────────────────────────────────────────
# Optional API key required in X-API-Key header.
# Leave blank to disable key-based auth (fine for local dev).
API_KEY=

# Secret used to sign any future JWT tokens (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_string_before_deploying


# ─── Cache / Performance ──────────────────────────────────────────
# How long (seconds) to cache NOAA responses before re-fetching.
# NOAA updates plasma data every ~1 min; 60s is a sensible default.
NOAA_CACHE_TTL_SECONDS=60

# Redis connection URL for distributed caching (optional).
# Leave blank to use in-process memory cache.
#   Example: REDIS_URL=redis://localhost:6379
REDIS_URL=


# ─── Database (optional — for persisting telemetry history) ───────
# Leave blank if you do not need persistent storage.
#   PostgreSQL example : postgresql://user:pass@localhost:5432/astrosentinel
#   SQLite example     : sqlite:./data/astrosentinel.db
DATABASE_URL=


# ─── Satellite Threat Evaluation ─────────────────────────────────
# Default maximum number of satellite threat results returned per call.
SAT_THREAT_LIMIT=50
